# /etc/caddy/Caddyfile
#
# Caddy obtains and renews the Let's Encrypt certificates on its own and
# redirects http to https automatically. There is no certbot step.

(common) {
	encode zstd gzip

	# A tool that strips tracking has no business keeping an access log.
	log {
		output discard
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
		-Server
	}

	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}

# =============================================================================
# TEMPORARY PUBLIC ADDRESS                       >>> DELETE THIS BLOCK <<<
#
# A stand-in so the site can be shared before untrackme.narek.actcollege.am
# has an A record. sslip.io is wildcard DNS: 109-94-170-160.sslip.io resolves
# to this server's IP, which is enough for Let's Encrypt to issue a real
# certificate without controlling any DNS zone.
#
# It is served noindex so it can never compete with the real domain in search
# results for the same content.
#
# Removal checklist lives in TEMPORARY.md in the repository root.
# =============================================================================
109-94-170-160.sslip.io {
	import common
	header X-Robots-Tag "noindex, nofollow"
}
# ======================= END OF TEMPORARY BLOCK ==============================

untrackme.narek.actcollege.am {
	import common
}
